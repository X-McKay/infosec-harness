{
  "openapi": "3.1.0",
  "info": {
    "title": "InfoSec Harness",
    "version": "3.0.0.dev0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "description": "Temporal connectivity only; sandbox, worker and model execution stay not_checked.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Temporal is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_api_runs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Finding"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Runs",
        "operationId": "runs_api_runs_get",
        "parameters": [
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8192
                },
                {
                  "type": "null"
                }
              ],
              "title": "Page Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Run",
        "operationId": "run_api_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/cancel": {
      "post": {
        "summary": "Cancel",
        "operationId": "cancel_api_runs__run_id__cancel_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Cancel Api Runs  Run Id  Cancel Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/events": {
      "get": {
        "summary": "Run Events",
        "description": "At most ``MAX_EVENTS`` history events as kinds, activity names and bounded labels.",
        "operationId": "run_events_api_runs__run_id__events_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunEvents"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "get": {
        "summary": "Reports",
        "description": "Newest report files first; one unreadable file never fails the listing.",
        "operationId": "reports_api_reports_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportList"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{name}": {
      "get": {
        "summary": "Report",
        "description": "One report document, validated as a JSON object. Its content is untrusted data.",
        "operationId": "report_api_reports__name__get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Report Api Reports  Name  Get"
                }
              }
            }
          },
          "404": {
            "description": "No such report"
          },
          "413": {
            "description": "Report exceeds 16 MiB"
          },
          "422": {
            "description": "Report is not a readable JSON object"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Path"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End Line"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "start_line",
          "end_line"
        ],
        "title": "Citation"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "command",
              "probe"
            ],
            "title": "Kind"
          },
          "command": {
            "type": "string",
            "title": "Command"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "stdout": {
            "type": "string",
            "title": "Stdout",
            "default": ""
          },
          "stderr": {
            "type": "string",
            "title": "Stderr",
            "default": ""
          },
          "timed_out": {
            "type": "boolean",
            "title": "Timed Out",
            "default": false
          },
          "output_truncated": {
            "type": "boolean",
            "title": "Output Truncated",
            "default": false
          },
          "sandbox_id": {
            "type": "string",
            "title": "Sandbox Id"
          },
          "source_digest": {
            "type": "string",
            "title": "Source Digest"
          },
          "observations": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Observations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "command",
          "exit_code",
          "sandbox_id",
          "source_digest"
        ],
        "title": "Evidence",
        "description": "Process fields are observed; text and observations remain untrusted claims."
      },
      "Finding": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 100000,
            "title": "Description",
            "default": ""
          },
          "repo_url": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Repo Url"
          },
          "revision": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Revision",
            "default": "HEAD"
          },
          "source_mode": {
            "type": "string",
            "enum": [
              "git_revision",
              "working_snapshot"
            ],
            "title": "Source Mode",
            "default": "git_revision"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          },
          "cwe": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^CWE-[0-9]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwe"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "repo_url"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "control_plane_ready",
              "temporal_unavailable"
            ],
            "title": "Status"
          },
          "temporal": {
            "type": "boolean",
            "title": "Temporal"
          },
          "runtime": {
            "type": "string",
            "const": "not_checked",
            "title": "Runtime",
            "default": "not_checked"
          },
          "generation": {
            "type": "string",
            "title": "Generation"
          },
          "task_queue": {
            "type": "string",
            "title": "Task Queue"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "temporal",
          "generation",
          "task_queue"
        ],
        "title": "Health",
        "description": "Temporal connectivity only; never sandbox, worker or model qualification."
      },
      "InvestigationResult": {
        "properties": {
          "finding": {
            "$ref": "#/components/schemas/Finding"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "source_digest": {
            "type": "string",
            "title": "Source Digest"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "worker_identity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkerIdentity"
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Usage"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding",
          "verdict",
          "evidence",
          "source_digest",
          "model"
        ],
        "title": "InvestigationResult"
      },
      "ReportList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReportSummary"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Items"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ReportList"
      },
      "ReportSummary": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "model",
              "diagnostic",
              "openshell",
              "replay",
              "unknown"
            ],
            "title": "Kind"
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "modified_at": {
            "type": "string",
            "title": "Modified At"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "planned": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planned"
          },
          "completed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed"
          },
          "task_success_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Success Rate"
          },
          "unsafe_negatives": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unsafe Negatives"
          },
          "gates": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Gates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind",
          "bytes",
          "modified_at"
        ],
        "title": "ReportSummary",
        "description": "Operator report files are untrusted and vary in shape: every parsed field is optional."
      },
      "RunEvent": {
        "properties": {
          "at": {
            "type": "string",
            "title": "At"
          },
          "kind": {
            "type": "string",
            "enum": [
              "workflow_started",
              "activity_scheduled",
              "activity_completed",
              "activity_failed",
              "activity_timed_out",
              "timer",
              "workflow_completed",
              "workflow_failed",
              "workflow_cancelled",
              "other"
            ],
            "title": "Kind"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "detail": {
            "type": "string",
            "maxLength": 200,
            "title": "Detail",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "at",
          "kind"
        ],
        "title": "RunEvent"
      },
      "RunEvents": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/RunEvent"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Events"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "events"
        ],
        "title": "RunEvents"
      },
      "RunPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Page Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "RunPage"
      },
      "RunState": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "finding": {
            "$ref": "#/components/schemas/Finding"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InvestigationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "phase",
          "finding"
        ],
        "title": "RunState"
      },
      "RunSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "potentially_exploitable",
                  "likely_not_exploitable",
                  "inconclusive"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          },
          "cwe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwe"
          },
          "repo_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "started_at"
        ],
        "title": "RunSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verdict": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "potentially_exploitable",
              "likely_not_exploitable",
              "inconclusive"
            ],
            "title": "Label"
          },
          "summary": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Summary"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Evidence Ids"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Citations"
          },
          "superseded_evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Superseded Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "summary"
        ],
        "title": "Verdict"
      },
      "WorkerIdentity": {
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Fingerprint"
          },
          "code_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Code Sha256"
          },
