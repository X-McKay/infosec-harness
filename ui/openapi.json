{
  "openapi": "3.1.0",
  "info": {
    "title": "InfoSec Harness",
    "version": "3.0.0.dev0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "summary": "Submit",
        "operationId": "submit_api_runs_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Finding"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Runs",
        "operationId": "runs_api_runs_get",
        "parameters": [
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8192
                },
                {
                  "type": "null"
                }
              ],
              "title": "Page Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}": {
      "get": {
        "summary": "Run",
        "operationId": "run_api_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{run_id}/cancel": {
      "post": {
        "summary": "Cancel",
        "operationId": "cancel_api_runs__run_id__cancel_post",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Cancel Api Runs  Run Id  Cancel Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Citation": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Path"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End Line"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "start_line",
          "end_line"
        ],
        "title": "Citation"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "command",
              "probe"
            ],
            "title": "Kind"
          },
          "command": {
            "type": "string",
            "title": "Command"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "stdout": {
            "type": "string",
            "title": "Stdout",
            "default": ""
          },
          "stderr": {
            "type": "string",
            "title": "Stderr",
            "default": ""
          },
          "timed_out": {
            "type": "boolean",
            "title": "Timed Out",
            "default": false
          },
          "output_truncated": {
            "type": "boolean",
            "title": "Output Truncated",
            "default": false
          },
          "sandbox_id": {
            "type": "string",
            "title": "Sandbox Id"
          },
          "source_digest": {
            "type": "string",
            "title": "Source Digest"
          },
          "observations": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Observations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "command",
          "exit_code",
          "sandbox_id",
          "source_digest"
        ],
        "title": "Evidence",
        "description": "Process fields are observed; text and observations remain untrusted claims."
      },
      "Finding": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 100000,
            "title": "Description",
            "default": ""
          },
          "repo_url": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Repo Url"
          },
          "revision": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Revision",
            "default": "HEAD"
          },
          "source_mode": {
            "type": "string",
            "enum": [
              "git_revision",
              "working_snapshot"
            ],
            "title": "Source Mode",
            "default": "git_revision"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          },
          "cwe": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^CWE-[0-9]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwe"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "repo_url"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvestigationResult": {
        "properties": {
          "finding": {
            "$ref": "#/components/schemas/Finding"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "source_digest": {
            "type": "string",
            "title": "Source Digest"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "worker_identity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkerIdentity"
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Usage"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "finding",
          "verdict",
          "evidence",
          "source_digest",
          "model"
        ],
        "title": "InvestigationResult"
      },
      "RunPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Page Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "RunPage"
      },
      "RunState": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "phase": {
            "type": "string",
            "title": "Phase"
          },
          "finding": {
            "$ref": "#/components/schemas/Finding"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InvestigationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "phase",
          "finding"
        ],
        "title": "RunState"
      },
      "RunSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "started_at"
        ],
        "title": "RunSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verdict": {
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "potentially_exploitable",
              "likely_not_exploitable",
              "inconclusive"
            ],
            "title": "Label"
          },
          "summary": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Summary"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Evidence Ids"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Citations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "summary"
        ],
        "title": "Verdict"
      },
      "WorkerIdentity": {
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Fingerprint"
          },
          "code_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Code Sha256"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Config Sha256"
          },
          "dependencies": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Dependencies"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fingerprint",
          "code_sha256",
          "config_sha256",
          "dependencies"
        ],
        "title": "WorkerIdentity"
      }
    }
  }
}
