+/// Default number of durable mutation admissions retained per caller.
+///
+/// Completed admissions are retained for the replay window and unresolved
+/// admissions are retained until reconciled, so every retained claim counts
+/// toward this quota.
+pub const DEFAULT_MAX_MUTATION_ADMISSIONS_PER_CALLER: u32 = 1000;
+
+/// Inclusive upper bound for the configurable per-caller admission quota.
+///
+/// The quota also bounds a single admission-pruning scan, so it must stay
+/// finite and small enough to read in one storage query.
+pub const MAX_MUTATION_ADMISSIONS_PER_CALLER_LIMIT: u32 = 1_000_000;
+
+/// Validate a per-caller durable mutation admission quota.
+///
+/// # Errors
+///
+/// Returns a static description when the quota is zero or exceeds
+/// [`MAX_MUTATION_ADMISSIONS_PER_CALLER_LIMIT`].
+pub const fn validate_max_mutation_admissions_per_caller(quota: u32) -> Result<u32, &'static str> {
+    if quota == 0 || quota > MAX_MUTATION_ADMISSIONS_PER_CALLER_LIMIT {
+        Err("must be an integer between 1 and 1000000 inclusive")
+    } else {
+        Ok(quota)
+    }
+}
