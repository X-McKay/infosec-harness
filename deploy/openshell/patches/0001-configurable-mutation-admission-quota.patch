+#[tokio::test]
+async fn pruning_scan_uses_configured_quota_and_keeps_unresolved_claims() {
+    let state = state_with_quota(Store::connect("sqlite::memory:").await.unwrap(), 3).await;
+    let quota = state.config.max_mutation_admissions_per_caller;
+    let bucket = format!("_mutation/prune-{}", uuid::Uuid::new_v4().simple());
+    fill_bucket(&state, &bucket, "a-unresolved", 2).await;
+    // Rows are listed by creation time then name, so the expired claim sorts
+    // after both unresolved claims and is only visible to a scan of 3 rows.
+    let expired = serde_json::to_vec(&Admission {
+        protection: None,
+        format_version: 1,
+        payload_hash: "unused".into(),
+        workspace_id: None,
+        target_id: None,
+        success: Some(Success::Deletion { outcome: 0 }),
+        completed_at_ms: Some(0),
+    })
+    .unwrap();
+    state
+        .store
+        .create_if_workspace_count_below(
+            OBJECT_TYPE,
+            "z-expired",
+            "z-expired",
+            &bucket,
+            &expired,
+            None,
+            u64::from(quota),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        !prune_expired(&state.store, &bucket, quota - 1)
+            .await
+            .unwrap()
+    );
+    assert!(
+        state
+            .store
+            .get(OBJECT_TYPE, "z-expired")
+            .await
+            .unwrap()
+            .is_some()
+    );
+    assert!(prune_expired(&state.store, &bucket, quota).await.unwrap());
+    assert!(
+        state
+            .store
+            .get(OBJECT_TYPE, "z-expired")
+            .await
+            .unwrap()
+            .is_none()
+    );
+    // Unresolved claims never expire, whatever the scan bound.
+    assert!(
+        !prune_expired(&state.store, &bucket, 1_000_000)
+            .await
+            .unwrap()
+    );
+    assert_eq!(
+        state
+            .store
+            .count_in_workspace(OBJECT_TYPE, &bucket)
+            .await
+            .unwrap(),
+        2
+    );
+}
