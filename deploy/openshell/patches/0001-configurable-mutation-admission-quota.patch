+    );
+    assert_eq!(control.calls.load(Ordering::SeqCst), 1);
+    let mut mismatch = completed.clone();
+    mismatch.labels.insert("changed".into(), "payload".into());
+    assert_eq!(
+        reason(&run(&raised, authed_request(mismatch)).await.unwrap_err()),
+        "REQUEST_ID_PAYLOAD_MISMATCH"
+    );
+    assert_eq!(
+        raised
+            .store
+            .count_in_workspace(Workspace::object_type(), "")
+            .await
+            .unwrap(),
+        workspaces
+    );
+    run(&raised, authed_request(refused)).await.unwrap();
+}
