+            Duration::from_secs(300)
+        );
+        assert_eq!(
+            idempotent_control_timeout(&Request::Attach {
+                supervisor_instance_id: crate::boundary_protocol::SupervisorInstanceId::new(),
+                policy: Box::new(SandboxPolicyWire::from(sandbox().policy)),
+                resource_claims: Default::default(),
+            }),
+            Duration::from_secs(300)
+        );
+        let ordinary = Request::Signal {
+            process_id: "secret-id".into(),
