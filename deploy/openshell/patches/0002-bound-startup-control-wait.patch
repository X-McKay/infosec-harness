 use crate::mediation::{self, DnsQueryWire, MediationFrame, MediationFrameKind};
 
 const REQUEST_TIMEOUT: Duration = Duration::from_secs(30);
+// Only initial confirmation/workload launch receives extra startup headroom.
+// This does not alter transport recovery, authorization, or enforcement checks.
+const STARTUP_CONTROL_TIMEOUT: Duration = Duration::from_secs(60);
+
+fn idempotent_control_timeout(request: &Request) -> Duration {
+    match request {
+        Request::Attach { .. } | Request::DiscoverPolicy => ATTACH_REQUEST_TIMEOUT,
+        Request::Confirm | Request::StartAgent { .. } => STARTUP_CONTROL_TIMEOUT,
+        _ => REQUEST_TIMEOUT,
+    }
+}
+
+fn idempotent_control_kind(request: &Request) -> &'static str {
+    match request {
+        Request::Attach { .. } => "attach",
+        Request::DiscoverPolicy => "discover_policy",
+        Request::Confirm => "confirm",
+        Request::StartAgent { .. } => "start_agent",
+        Request::UpdateProviderEnvironment { .. } => "update_provider_environment",
+        _ => "other",
+    }
+}
