+    // Inject a 1:100 clock scale only in this test client. The production
+    // timeout table is checked above; these exercise the actual exchange/retry
+    // loop without wall-clock 31/60-second sleeps or Cargo feature changes.
+    #[tokio::test]
+    async fn startup_control_delayed_31_succeeds_for_confirm_and_start() {
+        for request in [Request::Confirm, startup_control_request()] {
+            let probe = StartupControlProbe {
+                delay: Duration::from_millis(310),
+                ..Default::default()
+            };
+            let seen = probe.envelopes.clone();
+            let (client, server) = startup_control_client(probe, Duration::from_millis(600)).await;
+            let response = client.call_idempotent(request).await.unwrap();
+            assert!(matches!(
+                response,
+                Response::Confirmed { .. } | Response::Started { .. }
+            ));
+            assert_eq!(seen.lock().unwrap().len(), 1);
+            server.abort();
+        }
+    }
