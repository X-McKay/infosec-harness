+    #[tokio::test]
+    async fn startup_control_lost_reply_reuses_exact_start_envelope() {
+        let probe = StartupControlProbe {
+            lose_first_reply: true,
+            ..Default::default()
+        };
+        let seen = probe.envelopes.clone();
+        let (client, server) = startup_control_client(probe, Duration::from_secs(2)).await;
+        assert!(matches!(
+            client
+                .call_idempotent(startup_control_request())
+                .await
+                .unwrap(),
+            Response::Started { .. }
+        ));
+        let seen = seen.lock().unwrap();
+        assert_eq!(seen.len(), 2);
+        assert_eq!(seen[0], seen[1]);
+        // The boundary replay ledger receives one unique start identity.
+        assert_eq!(
+            seen.iter().collect::<std::collections::HashSet<_>>().len(),
+            1
+        );
+        server.abort();
+    }
