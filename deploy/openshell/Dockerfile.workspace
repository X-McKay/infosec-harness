# Trusted multi-language toolbox; runtime instances are owned and confined by OpenShell.
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
ARG HTTP_PROXY
ARG HTTPS_PROXY
RUN apt-get update && python3 - <<'PY'
import os
import shutil
import stat
import subprocess
import tempfile

packages = [
    "ca-certificates", "nodejs", "npm", "default-jdk-headless", "maven",
    "perl", "cpanminus", "gcc", "make",
]
simulation = subprocess.run(
    ["apt-get", "-s", "install", "--no-install-recommends", *packages],
    check=True, text=True, capture_output=True,
).stdout
upgrades = [line.split()[1] for line in simulation.splitlines() if line.startswith("Inst ")]
files = set()
for package in upgrades:
    listing = subprocess.run(
        ["dpkg-query", "-L", package], check=False, text=True, capture_output=True,
    )
    if listing.returncode:
        continue
    files.update(listing.stdout.splitlines())

# runsc's BuildKit overlay cannot hard-link lower-layer package files for dpkg
# backups. Copy only regular files owned by packages apt will upgrade into the
# writable layer first, preserving their modes and timestamps.
for name in sorted(files):
    try:
        info = os.lstat(name)
    except FileNotFoundError:
        continue
    if not (stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode)):
        continue
    fd, temporary = tempfile.mkstemp(prefix=".dpkg-copyup-", dir=os.path.dirname(name) or "/")
    os.close(fd)
    try:
        if stat.S_ISLNK(info.st_mode):
            os.unlink(temporary)
            os.symlink(os.readlink(name), temporary)
        else:
            shutil.copyfile(name, temporary)
            shutil.copystat(name, temporary, follow_symlinks=False)
        os.replace(temporary, name)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

# Keep package copy-up and dpkg unpack in this same layer; a later RUN would
# make the copied paths lower-layer files again to the package installer.
subprocess.run(
    ["apt-get", "install", "-y", "--no-install-recommends", *packages],
    check=True,
)
shutil.rmtree("/var/lib/apt/lists", ignore_errors=True)
os.makedirs("/workspace", exist_ok=True)
os.chown("/workspace", 65532, 65532)
PY
ENV PYTHONDONTWRITEBYTECODE=1
USER 65532:65532
WORKDIR /workspace
ENTRYPOINT []
CMD ["sleep", "infinity"]
