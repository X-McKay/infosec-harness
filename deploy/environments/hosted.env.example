# Operator template; replace reserved example endpoints and credentials before use.
HARNESS_DATABASE_URL=postgresql+asyncpg://harness:REPLACE_ME@db.example.invalid:5432/harness
HARNESS_DATABASE_TLS=true
# Optional custom CA: HARNESS_DATABASE_TLS_CA_FILE=/var/run/harness/tls/database-ca.pem
HARNESS_TEMPORAL_ADDRESS=triage.account.tmprl.cloud:7233
HARNESS_TEMPORAL_NAMESPACE=triage.account
HARNESS_TEMPORAL_TLS=true
HARNESS_TEMPORAL_API_KEY_FILE=/var/run/harness/tls/temporal-api-key
# Or use HARNESS_TEMPORAL_TLS_CLIENT_CERT and HARNESS_TEMPORAL_TLS_CLIENT_KEY for mTLS.
HARNESS_TASK_QUEUE=triage-hosted
HARNESS_MODEL_MODE=stub
HARNESS_ARTIFACT_BACKEND=s3
HARNESS_S3_BUCKET=REPLACE_ME
HARNESS_S3_REGION=us-east-1
HARNESS_S3_CREATE_BUCKET=false
# AWS workload identity/default credential chain; no custom endpoint required.
# For hosted MinIO: HARNESS_S3_ENDPOINT=https://objects.example.invalid
HARNESS_WORKSPACE_DIR=/workspace
HARNESS_ENVIRONMENT=hosted
