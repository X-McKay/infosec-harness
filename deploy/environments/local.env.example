# Standalone local clients; ./dev owns its generated configuration separately.
HARNESS_DATABASE_URL=postgresql+asyncpg://harness:harness@localhost:5432/harness
HARNESS_DATABASE_TLS=false
HARNESS_TEMPORAL_ADDRESS=localhost:7233
HARNESS_TEMPORAL_NAMESPACE=default
HARNESS_TEMPORAL_TLS=false
HARNESS_TASK_QUEUE=triage-local
HARNESS_MODEL_MODE=stub
HARNESS_ARTIFACT_BACKEND=filesystem
HARNESS_WORKSPACE_DIR=.harness/workspace
HARNESS_ENVIRONMENT=local
