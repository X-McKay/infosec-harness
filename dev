#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$ROOT_DIR"
PROFILE=full
COMMAND=start
SERVICE=""
ENV_FILE=.harness/dev.env
VERSIONS_FILE=.dev-tools/versions.env

usage() {
  cat <<'EOF'
Usage: ./dev [--profile full|offline] [start|reload|status|logs|smoke|doctor|stop]

The default profile provisions pinned tools and a checkout-owned Linux VM, verifies the runsc
sandbox plus its build-egress boundary, starts the complete stack, and runs a stub assessment
through the API and real Temporal worker. It never changes the host Docker context or daemon.
The offline profile runs component checks and explicitly does not check Temporal or isolation.
stop preserves this checkout's VM, volumes, findings, downloads, and generated configuration.
reload restarts the editable API and worker after backend source changes without touching data.
EOF
}

while (($#)); do
  case "$1" in
    --profile) PROFILE="${2:?--profile needs full or offline}"; shift 2 ;;
    --profile=*) PROFILE="${1#*=}"; shift ;;
    start|reload|status|smoke|doctor|stop) COMMAND="$1"; shift ;;
    logs)
      COMMAND=logs
      if (($# > 1)); then SERVICE="$2"; shift 2; else shift; fi
      ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done
if [[ "$PROFILE" != full && "$PROFILE" != offline ]]; then
  echo "profile must be full or offline" >&2
  exit 2
fi

pin() {
  awk -F= -v key="$1" '$1 == key {print $2; exit}' "$VERSIONS_FILE"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "missing sha256sum or shasum; cannot verify managed tool downloads" >&2
    return 2
  fi
}

download() {
  local url=$1 destination=$2 partial="${2}.part"
  mkdir -p "$(dirname "$destination")"
  echo "download: $url"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --show-error --progress-bar "$url" --output "$partial"
  elif command -v wget >/dev/null 2>&1; then
    wget --progress=bar:force:noscroll --output-document="$partial" "$url"
  else
    echo "missing curl or wget; one is required for the initial managed bootstrap" >&2
    return 2
  fi
  mv "$partial" "$destination"
}

bootstrap_mise() {
  local version system machine artifact checksum url actual
  version="$(pin MISE_VERSION)"
  system="$(uname -s)"
  machine="$(uname -m)"
  case "$system/$machine" in
    Darwin/arm64|Darwin/aarch64)
      artifact="mise-v${version}-macos-arm64"
      checksum="$(pin MISE_MACOS_ARM64_SHA256)"
      ;;
    Linux/x86_64|Linux/amd64)
      artifact="mise-v${version}-linux-x64"
      checksum="$(pin MISE_LINUX_X64_SHA256)"
      ;;
    *)
      echo "unsupported host $system/$machine; supported: macOS Apple Silicon, Linux x86-64" >&2
      return 2
      ;;
  esac
  MISE_BIN="$ROOT_DIR/.harness/bin/mise"
  if [[ ! -x "$MISE_BIN" ]] || [[ "$(sha256_file "$MISE_BIN")" != "$checksum" ]]; then
    url="https://github.com/jdx/mise/releases/download/v${version}/${artifact}"
    download "$url" "$MISE_BIN"
    actual="$(sha256_file "$MISE_BIN")"
    if [[ "$actual" != "$checksum" ]]; then
      rm -f "$MISE_BIN"
      echo "mise checksum mismatch: expected $checksum, got $actual" >&2
      return 2
    fi
    chmod 0755 "$MISE_BIN"
  fi
  export MISE_BIN
  export MISE_DATA_DIR="$ROOT_DIR/.harness/mise"
  export MISE_CACHE_DIR="$ROOT_DIR/.harness/mise-cache"
  export MISE_STATE_DIR="$ROOT_DIR/.harness/mise-state"
  export MISE_IGNORED_CONFIG_PATHS="${HOME}/.tool-versions:${HOME}/.config/mise/config.toml:${HOME}/.config/mise/conf.d"
  export PATH="$ROOT_DIR/.harness/bin:$PATH"
}

MISE_BIN="$ROOT_DIR/.harness/bin/mise"
export MISE_BIN
export MISE_DATA_DIR="$ROOT_DIR/.harness/mise"
export MISE_CACHE_DIR="$ROOT_DIR/.harness/mise-cache"
export MISE_STATE_DIR="$ROOT_DIR/.harness/mise-state"
export MISE_IGNORED_CONFIG_PATHS="${HOME}/.tool-versions:${HOME}/.config/mise/config.toml:${HOME}/.config/mise/conf.d"
export PATH="$ROOT_DIR/.harness/bin:$PATH"
case "$COMMAND" in
  start|smoke|doctor) bootstrap_mise ;;
  status) if [[ "$PROFILE" == offline ]]; then bootstrap_mise; fi ;;
esac

setup() {
  "$MISE_BIN" exec -- python scripts/dev_setup.py --profile "$PROFILE" "$@"
  export PATH="$ROOT_DIR/.harness/bin:$PATH"
}

load_env() {
  [[ -f "$ENV_FILE" ]] || { echo "no local environment; run ./dev first" >&2; return 2; }
  set -a
  # Generated by dev_setup.py with shell-quoted values and mode 0600.
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

compose() {
  load_env
  docker compose -f docker-compose.yml -f docker-compose.dev.yml \
    --project-name "$COMPOSE_PROJECT_NAME" --env-file "$ENV_FILE" "$@"
}

python_managed() {
  "$MISE_BIN" exec -- uv run --locked python "$@"
}

offline() {
  setup
  "$MISE_BIN" exec -- uv run harness agents validate
  echo "offline profile ready: stub/component checks passed"
  echo "real Temporal, API, web, persistence, and sandbox readiness: not_checked"
}

verify_sandbox() {
  load_env
  python_managed scripts/dev_sandbox_check.py \
    --runtime "$HARNESS_SANDBOX_RUNTIME" \
    --network "$HARNESS_BUILD_EGRESS_NETWORK" \
    --proxy "$HARNESS_BUILD_EGRESS_PROXY" \
    --builder "$HARNESS_BUILDX_BUILDER" \
    --compose-project "$COMPOSE_PROJECT_NAME"
}

smoke_stack() {
  load_env
  python_managed scripts/dev_setup_smoke.py \
    --api-url "http://127.0.0.1:${HARNESS_API_PORT}" \
    --web-url "http://127.0.0.1:${HARNESS_WEB_PORT}" \
    --minio-url "http://127.0.0.1:${HARNESS_MINIO_PORT}/minio/health/ready"
}

start_full() {
  setup
  # Recreate so an edited allowlist is active before any build reaches the boundary.
  compose up -d --force-recreate egress-proxy
  verify_sandbox
  compose up --build -d
  smoke_stack
  echo "profile: full (stub inference; zero credentials and zero paid requests)"
  echo "sandbox: runsc probe and allowlisted build boundary passed"
  echo "temporal: deterministic API submission reached a terminal persisted result"
  echo "web: http://127.0.0.1:${HARNESS_WEB_PORT}"
  echo "api: http://127.0.0.1:${HARNESS_API_PORT}/docs"
  echo "temporal: http://127.0.0.1:${HARNESS_TEMPORAL_UI_PORT}"
  echo "artifacts: http://127.0.0.1:${HARNESS_MINIO_CONSOLE_PORT}"
  echo "traces: http://127.0.0.1:${HARNESS_JAEGER_PORT}"
  echo "logs: ./dev logs"
  echo "stop: ./dev stop (preserves VM, configuration, and data)"
}

case "$COMMAND" in
  start)
    if [[ "$PROFILE" == offline ]]; then offline; else start_full; fi
    ;;
  status)
    if [[ "$PROFILE" == offline ]]; then
      setup --check-only
      echo "offline profile: available (services are not running)"
    else
      compose ps
    fi
    ;;
  reload)
    compose restart api worker
    load_env
    python_managed scripts/dev_setup_smoke.py \
      --api-url "http://127.0.0.1:${HARNESS_API_PORT}" \
      --web-url "http://127.0.0.1:${HARNESS_WEB_PORT}" \
      --minio-url "http://127.0.0.1:${HARNESS_MINIO_PORT}/minio/health/ready"
    echo "reloaded API and worker; persisted data was preserved"
    ;;
  logs)
    if [[ -n "$SERVICE" ]]; then compose logs --tail=100 "$SERVICE"; else compose logs --tail=100; fi
    ;;
  smoke)
    if [[ "$PROFILE" == offline ]]; then
      offline
    else
      setup --check-only
      verify_sandbox
      smoke_stack
    fi
    ;;
  doctor)
    setup --check-only
    if [[ "$PROFILE" == full ]]; then verify_sandbox; fi
    ;;
  stop)
    compose down
    echo "stopped $COMPOSE_PROJECT_NAME; VM, configuration, volumes, and findings were preserved"
    ;;
esac
