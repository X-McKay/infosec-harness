#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$ROOT_DIR"

# The checkout that owns .harness/ (managed tools, VM, Temporal database, private configuration
# and logs): the main working tree when this is a linked git worktree, so every worktree drives
# the one live runtime. scripts/dev_setup.py resolves the same directory.
main_checkout() {
  local common
  common="$(git -C "$ROOT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
    common=""
  if [[ -n "$common" && "$(basename -- "$common")" == .git ]]; then
    (cd -- "$(dirname -- "$common")" && pwd -P)
  else
    printf '%s\n' "$ROOT_DIR"
  fi
}
MAIN_DIR="$(main_checkout)"
HARNESS_DIR="$MAIN_DIR/.harness"
ENV_FILE="$HARNESS_DIR/dev.env"
RUN_DIR="$HARNESS_DIR/run"
TEMPORAL_DB="$HARNESS_DIR/temporal/temporal.db"
# The private native OpenShell runtime configuration, in order of preference: the layout
# deploy/openshell/README.md prescribes, then the earlier default path. An explicit
# HARNESS_OPENSHELL_CONFIG is used only when neither file exists.
PRIVATE_OPENSHELL_CONFIG="$HARNESS_DIR/openshell/private/native-config.json"
RUNTIME_OPENSHELL_CONFIG="$HARNESS_DIR/openshell/runtime.json"
# The dev server's default namespace keeps closed histories for one day; keep them 30 days so
# replay evidence survives. Export anything needed longer with ./dev export-history.
TEMPORAL_RETENTION=720h
SERVICES=(temporal api ui)
VERSIONS_FILE=.dev-tools/versions.env

PROFILE=full
if [[ "${1:-}" == --profile ]]; then PROFILE="${2:?profile required}"; shift 2; fi
COMMAND="${1:-start}"
if (($#)); then shift; fi
[[ "$PROFILE" == full || "$PROFILE" == offline ]] || { echo "profile must be full or offline" >&2; exit 2; }

usage() {
  cat <<'USAGE'
Usage: ./dev [--profile full|offline] [COMMAND] [ARGS]
Commands:
  start           default; full: VM, local Temporal/API/UI, readiness, qualify; offline: checks
  check           lint and compile
  test            deterministic tests with a real local Temporal; no model calls
  worker          trusted Temporal worker on native OpenShell
  qualify         native boundaries; no model calls
  eval            live corpus, owned worker on a fresh queue; --case never qualifies
  replay          zero-dispatch history replay of RUN_ID
  export-history  write RUN_ID's workflow history JSON (default .harness/histories/); no overwrite
  status          local Temporal, API and UI processes, URLs and the Temporal database
  logs            last 100 lines of the temporal, api and ui logs (or one NAME)
  smoke           bounded GET-only control-plane readiness, then qualify
  doctor          verify pinned tools and the VM without changing them; full: qualify
  env             print shell lines putting the managed uv, just, node and temporal on PATH
  stop            stop the local Temporal, API and UI; keeps the database, VM and all data
--settings FILE is accepted anywhere among the arguments of worker|qualify|eval|replay|export-history.
Full mode requires explicit OpenShell configuration; see deploy/openshell/README.md. Without
--settings, worker|qualify|eval|replay read .harness/openshell/private/native-config.json, else
.harness/openshell/runtime.json, else HARNESS_OPENSHELL_CONFIG; start, smoke and doctor report
native qualification not_checked when none exists.
From a git worktree every command uses the main checkout's .harness/; start the stack there.
USAGE
}

pin() {
  awk -F= -v key="$1" '$1 == key {print $2; exit}' "$VERSIONS_FILE"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "missing sha256sum or shasum; cannot verify managed tool downloads" >&2
    return 2
  fi
}

download() {
  local url=$1 destination=$2 partial="${2}.part"
  mkdir -p "$(dirname "$destination")"
  echo "download: $url"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --show-error --progress-bar "$url" --output "$partial"
  elif command -v wget >/dev/null 2>&1; then
    wget --progress=bar:force:noscroll --output-document="$partial" "$url"
  else
    echo "missing curl or wget; one is required for the initial managed bootstrap" >&2
    return 2
  fi
  mv "$partial" "$destination"
}

# Checkout-local mise state. .mise.toml is trusted by path (it pins the Temporal CLI by URL and
# hash, which mise only reads from a trusted file) without writing any global trust record.
MISE_BIN="$HARNESS_DIR/bin/mise"
export MISE_BIN
export MISE_DATA_DIR="$HARNESS_DIR/mise"
export MISE_CACHE_DIR="$HARNESS_DIR/mise-cache"
export MISE_STATE_DIR="$HARNESS_DIR/mise-state"
export MISE_IGNORED_CONFIG_PATHS="${HOME}/.tool-versions:${HOME}/.config/mise/config.toml:${HOME}/.config/mise/conf.d"
export MISE_TRUSTED_CONFIG_PATHS="$ROOT_DIR/.mise.toml"
export PATH="$HARNESS_DIR/bin:$PATH"

bootstrap_mise() {
  local version system machine artifact checksum url actual
  version="$(pin MISE_VERSION)"
  system="$(uname -s)"
  machine="$(uname -m)"
  case "$system/$machine" in
    Darwin/arm64|Darwin/aarch64)
      artifact="mise-v${version}-macos-arm64"
      checksum="$(pin MISE_MACOS_ARM64_SHA256)"
      ;;
    Linux/x86_64|Linux/amd64)
      artifact="mise-v${version}-linux-x64"
      checksum="$(pin MISE_LINUX_X64_SHA256)"
      ;;
    *)
      echo "unsupported host $system/$machine; supported: macOS Apple Silicon, Linux x86-64" >&2
      return 2
      ;;
  esac
  if [[ ! -x "$MISE_BIN" ]] || [[ "$(sha256_file "$MISE_BIN")" != "$checksum" ]]; then
    url="https://github.com/jdx/mise/releases/download/v${version}/${artifact}"
    download "$url" "$MISE_BIN"
    actual="$(sha256_file "$MISE_BIN")"
    if [[ "$actual" != "$checksum" ]]; then
      rm -f "$MISE_BIN"
      echo "mise checksum mismatch: expected $checksum, got $actual" >&2
      return 2
    fi
    chmod 0755 "$MISE_BIN"
  fi
}

# Shell lines for an interactive shell: the managed tools, never the VM docker shim.
print_env() {
  [[ -x "$MISE_BIN" ]] || { echo "managed tools are missing; run ./dev in $MAIN_DIR first" >&2; return 2; }
  local paths
  paths="$("$MISE_BIN" bin-paths | paste -sd: -)"
  [[ -n "$paths" ]] || { echo "no managed tools are installed; run ./dev in $MAIN_DIR first" >&2; return 2; }
  echo "# Managed tools for $ROOT_DIR (state: $HARNESS_DIR). Apply with: eval \"\$(./dev env)\""
  printf 'export PATH=%q:"$PATH"\n' "$paths"
  echo "export UV_PYTHON_DOWNLOADS=never"
}

case "$COMMAND" in
  help|-h|--help) usage; exit 0 ;;
  env) print_env; exit ;;
  start)
    if [[ "$PROFILE" == full && "$MAIN_DIR" != "$ROOT_DIR" ]]; then
      echo "the live stack belongs to the main checkout; run ./dev there: $MAIN_DIR" >&2
      echo "From this worktree use ./dev --profile offline, qualify, eval, replay or status." >&2
      exit 2
    fi ;;
esac
bootstrap_mise
managed() { "$MISE_BIN" exec -- "$@"; }
setup() { managed python scripts/dev_setup.py --profile "$PROFILE" "$@"; }
load_env() {
  [[ -f "$ENV_FILE" ]] || { echo "run ./dev in $MAIN_DIR first ($ENV_FILE is missing)" >&2; return 2; }
  set -a
  source "$ENV_FILE"
  set +a
  export HARNESS_TEMPORAL_ADDRESS="127.0.0.1:$HARNESS_TEMPORAL_PORT"
  # Unless the operator names an allowlist, a worker started here reads only this checkout's
  # approved corpus. The native runtime configuration lives in the owning checkout.
  if [[ -z "${HARNESS_LOCAL_REPO_ROOTS:-}" ]]; then
    [[ "$ROOT_DIR" != *[\"\\]* ]] || { echo "checkout path cannot be encoded as JSON" >&2; return 2; }
    export HARNESS_LOCAL_REPO_ROOTS="[\"$ROOT_DIR/eval-corpus\"]"
  fi
}
# Prints the OpenShell configuration a harness command reads; fails when none exists.
openshell_config() {
  local candidate
  for candidate in "$PRIVATE_OPENSHELL_CONFIG" "$RUNTIME_OPENSHELL_CONFIG" \
      "${HARNESS_OPENSHELL_CONFIG:-}"; do
    if [[ -n "$candidate" && -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}
no_openshell_config() {
  local explicit="HARNESS_OPENSHELL_CONFIG is unset"
  [[ -z "${HARNESS_OPENSHELL_CONFIG:-}" ]] ||
    explicit="HARNESS_OPENSHELL_CONFIG=$HARNESS_OPENSHELL_CONFIG does not exist"
  echo "No private OpenShell configuration: neither $PRIVATE_OPENSHELL_CONFIG nor"
  echo "$RUNTIME_OPENSHELL_CONFIG exists, and $explicit."
  echo "Create it as deploy/openshell/README.md describes, or pass --settings FILE."
}
harness() {
  # --settings is a global harness option; accept it anywhere among the verb's arguments.
  local command=$1 settings=() args=()
  shift
  while (($#)); do
    case "$1" in
      --settings|--settings=*)
        ((${#settings[@]} == 0)) || { echo "--settings given more than once" >&2; return 2; }
        if [[ "$1" == --settings ]]; then
          settings=(--settings "${2:?settings file required}"); shift 2
        else
          settings=(--settings "${1#--settings=}"); shift
        fi ;;
      *) args+=("$1"); shift ;;
    esac
  done
  load_env
  local config
  if ((${#settings[@]})); then
    echo "OpenShell configuration: openshell_config in ${settings[1]}" >&2
  elif config="$(openshell_config)"; then
    if [[ -n "${HARNESS_OPENSHELL_CONFIG:-}" && "$HARNESS_OPENSHELL_CONFIG" != "$config" ]]; then
      echo "OpenShell configuration: $config (preferred over HARNESS_OPENSHELL_CONFIG=$HARNESS_OPENSHELL_CONFIG)" >&2
    else
      echo "OpenShell configuration: $config" >&2
    fi
    export HARNESS_OPENSHELL_CONFIG="$config"
  else
    case "$command" in
      replay|export-history) ;;  # they read Temporal histories, not the native runtime
      *) no_openshell_config >&2; return 2 ;;
    esac
  fi
  managed uv run --locked harness ${settings[@]+"${settings[@]}"} "$command" ${args[@]+"${args[@]}"}
}
qualify() { harness qualify "$@"; }
# start, smoke and doctor: qualify the native boundaries when a private configuration exists;
# otherwise say so and leave them not_checked instead of failing on a missing file.
QUALIFIED=0
qualify_if_configured() {
  load_env
  if openshell_config >/dev/null; then
    qualify
    QUALIFIED=1
    return 0
  fi
  no_openshell_config
  echo "Native OpenShell qualification: not_checked"
}

# Each local service runs in its own process group. Its pid file records the group leader's pid
# and start time, so stop never signals a process that merely reused the pid.
service_pid() {
  local file="$RUN_DIR/$1.pid" pid="" started=""
  [[ -f "$file" ]] || return 0
  { IFS= read -r pid; IFS= read -r started; } <"$file" || true
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || { echo "$1: unreadable pid file $file" >&2; return 2; }
  kill -0 "$pid" 2>/dev/null || return 0
  if [[ "$(ps -o lstart= -p "$pid")" != "$started" || "$(ps -o pgid= -p "$pid" | tr -d ' ')" != "$pid" ]]; then
    echo "$1: pid $pid is no longer the process ./dev started; leaving it alone" >&2
    return 0
  fi
  printf '%s\n' "$pid"
}
start_service() {
  local name=$1 log="$RUN_DIR/$1.log" pid started
  shift
  pid="$(service_pid "$name")"
  if [[ -n "$pid" ]]; then echo "$name: running (pid $pid)"; return 0; fi
  mkdir -p "$RUN_DIR"
  if [[ -f "$log" ]]; then mv -f "$log" "$log.1"; fi
  set -m
  nohup "$@" </dev/null >"$log" 2>&1 &
  pid=$!
  set +m
  started="$(ps -o lstart= -p "$pid" || true)"
  if [[ -z "$started" ]]; then
    tail -n 20 "$log" >&2 || true
    echo "$name: exited immediately; see $log" >&2
    return 2
  fi
  printf '%s\n%s\n' "$pid" "$started" >"$RUN_DIR/$name.pid"
  echo "$name: started (pid $pid, log $log)"
}
stop_service() {
  local name=$1 pid
  pid="$(service_pid "$name")"
  if [[ -z "$pid" ]]; then
    rm -f "$RUN_DIR/$name.pid"
    echo "$name: not running"
    return 0
  fi
  kill -TERM -- "-$pid" 2>/dev/null || true
  for _ in $(seq 1 60); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.5
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "$name: still running 30 s after SIGTERM (pid $pid); not forced" >&2
    return 2
  fi
  rm -f "$RUN_DIR/$name.pid"
  echo "$name: stopped"
}
wait_for_temporal() {
  for _ in $(seq 1 120); do
    if managed temporal operator cluster health --address "$HARNESS_TEMPORAL_ADDRESS" >/dev/null 2>&1; then
      return 0
    fi
    [[ -n "$(service_pid temporal)" ]] || break
    sleep 0.5
  done
  tail -n 20 "$RUN_DIR/temporal.log" >&2 || true
  echo "Temporal did not become ready on $HARNESS_TEMPORAL_ADDRESS" >&2
  return 2
}
# The pinned Temporal CLI dev server with a persistent SQLite database and its bundled UI,
# bound to loopback; then the API and the Vite UI. Temporal keeps running across ./dev; the
# stateless API and UI restart so they serve the current code.
start_stack() {
  load_env
  mkdir -p "$(dirname "$TEMPORAL_DB")" "$RUN_DIR"
  # nohup runs programs, not shell functions: name the managed mise exec explicitly.
  start_service temporal "$MISE_BIN" exec -- temporal server start-dev \
    --db-filename "$TEMPORAL_DB" --ip 127.0.0.1 --port "$HARNESS_TEMPORAL_PORT" \
    --ui-ip 127.0.0.1 --ui-port "$HARNESS_TEMPORAL_UI_PORT" --ui-disable-news-fetch \
    --log-level warn
  wait_for_temporal
  managed temporal operator namespace update --namespace default \
    --retention "$TEMPORAL_RETENTION" --address "$HARNESS_TEMPORAL_ADDRESS" >/dev/null
  stop_service ui
  stop_service api
  start_service api "$MISE_BIN" exec -- uv run --locked harness api \
    --host 127.0.0.1 --port "$HARNESS_API_PORT"
  export VITE_API_URL="http://127.0.0.1:$HARNESS_API_PORT"
  start_service ui "$MISE_BIN" exec -- npm --prefix ui run dev -- \
    --host 127.0.0.1 --port "$HARNESS_WEB_PORT" --strictPort
}
ready() {
  load_env
  managed python scripts/dev_setup.py ready \
    --api-url "http://127.0.0.1:$HARNESS_API_PORT" \
    --web-url "http://127.0.0.1:$HARNESS_WEB_PORT" \
    --temporal-ui-url "http://127.0.0.1:$HARNESS_TEMPORAL_UI_PORT"
}
status() {
  load_env
  local name pid url
  for name in "${SERVICES[@]}"; do
    case "$name" in
      temporal) url="$HARNESS_TEMPORAL_ADDRESS, UI http://127.0.0.1:$HARNESS_TEMPORAL_UI_PORT" ;;
      api) url="http://127.0.0.1:$HARNESS_API_PORT" ;;
      ui) url="http://127.0.0.1:$HARNESS_WEB_PORT" ;;
    esac
    pid="$(service_pid "$name")"
    if [[ -n "$pid" ]]; then
      printf '%-9s running  pid %-7s %s\n' "$name" "$pid" "$url"
    else
      printf '%-9s stopped\n' "$name"
    fi
  done
  echo "Temporal database: $TEMPORAL_DB"
  echo "logs: $RUN_DIR"
}
logs() {
  local name names=("${SERVICES[@]}")
  if (($#)); then names=("$@"); fi
  for name in "${names[@]}"; do
    [[ " ${SERVICES[*]} " == *" $name "* ]] || { echo "unknown service: $name (${SERVICES[*]})" >&2; return 2; }
    echo "==> $RUN_DIR/$name.log <=="
    tail -n 100 "$RUN_DIR/$name.log" 2>/dev/null || echo "(no log)"
  done
}

case "$COMMAND" in
  start)
    setup
    managed just bootstrap
    if [[ "$PROFILE" == offline ]]; then
      managed just check
      HARNESS_TEST_REQUIRE_TEMPORAL=1 managed just test
      echo "Native OpenShell and live inference: not_checked (offline profile)"
    else
      start_stack
      ready
      qualify_if_configured
      if ((QUALIFIED)); then
        echo "Control plane and OpenShell checked. Start a worker with ./dev worker."
      else
        echo "Control plane checked. Configure native OpenShell, then run ./dev qualify."
      fi
      echo "Live model inference: not_checked; configure an explicit provider before submitting."
    fi ;;
  check) managed just check "$@" ;;
  test) HARNESS_TEST_REQUIRE_TEMPORAL=1 managed just test "$@" ;;
  worker) harness worker "$@" ;;
  qualify) qualify "$@" ;;
  eval) harness eval "$@" --allow-inference --owned-worker ;;
  replay) harness replay "$@" ;;
  export-history) harness export-history "$@" ;;
  status) status ;;
  logs) logs "$@" ;;
  smoke) ready; qualify_if_configured ;;
  doctor) setup --check-only; if [[ "$PROFILE" == full ]]; then qualify_if_configured; fi ;;
  stop)
    failed=0
    for name in ui api temporal; do stop_service "$name" || failed=1; done
    echo "Temporal database, VM and data preserved; ./dev starts them again."
    exit "$failed" ;;
  *) echo "unknown command: $COMMAND (see ./dev help)" >&2; exit 2 ;;
esac
