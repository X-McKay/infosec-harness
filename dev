#!/usr/bin/env bash
# Must run under macOS's stock /bin/bash 3.2: no associative arrays, no ${var,,}, and empty
# arrays are expanded as ${a[@]+"${a[@]}"} because "${a[@]}" is an unbound error under set -u.
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$ROOT_DIR"
PROFILE=full
COMMAND=start
SERVICE=""
STOP_VM=false
ASSUME_YES=false
GC_DELETE=false
VALIDATION_ARGS=()
ENV_FILE=.harness/dev.env
VERSIONS_FILE=.dev-tools/versions.env

usage() {
  cat <<'EOF'
Usage: ./dev [--profile full|offline] [COMMAND] [OPTIONS]

Commands:
  start               (default) full: pinned tools, checkout-owned VM, runsc sandbox and
                      build-egress fixtures, complete stack, stub assessment through the API
                      and real Temporal worker. offline: pinned tools, then just check and
                      just test with stub models; Temporal service, API, web, persistence and
                      sandbox are not checked.
  check               just check with the pinned tools (lint, compile, agent validation)
  test                just test with the pinned tools (deterministic suite; the pinned
                      Temporal CLI is required, network-marked tests are excluded)
  status              offline: pinned tools present; full: compose service status
  logs [SERVICE]      display and save a bounded log snapshot under .harness/logs/
  smoke               full: re-run the readiness, sandbox and stub assessment checks;
                      offline: same as start
  doctor              check pinned tools, the VM and (full) the sandbox fixtures
  validate [OPTIONS]  check running services without submissions
                      --model adds one explicit inference request; --report PATH keeps a
                      sanitized report; --connectivity-receipt PATH publishes a successful check
  reload              restart the editable API and worker, then run the stub/runtime smoke
  reload-ui           restart API and web, then verify integration with GET-only checks
  stop [--vm]         stop the stack; preserves this checkout's VM, volumes, findings,
                      downloads, and generated configuration. --vm also stops the VM.
  reset [--yes]       delete this checkout's VM, volumes, findings and generated
                      configuration (asks for confirmation; keeps pinned tools and reports)
  gc [--delete]       list VM homes under ~/.cache/ih; --delete removes those whose
                      checkout no longer exists

./dev never changes the host Docker context, daemon, shell profiles or global tools.
EOF
}

while (($#)); do
  case "$1" in
    --profile) PROFILE="${2:?--profile needs full or offline}"; shift 2 ;;
    --profile=*) PROFILE="${1#*=}"; shift ;;
    start|check|test|reload|reload-ui|status|smoke|doctor|validate|stop|reset|gc)
      COMMAND="$1"; shift ;;
    logs)
      COMMAND=logs
      # Only a following non-option word names a service: `logs --profile offline` must not
      # read "--profile" as the service.
      if (($# > 1)) && [[ "$2" != -* ]]; then SERVICE="$2"; shift 2; else shift; fi
      ;;
    --vm) STOP_VM=true; shift ;;
    --yes) ASSUME_YES=true; shift ;;
    --delete) GC_DELETE=true; shift ;;
    --model) VALIDATION_ARGS+=("$1"); shift ;;
    --report|--connectivity-receipt|--timeout|--model-timeout|--api-url|--web-url|--worker-hostname|--expected-source-commit)
      VALIDATION_ARGS+=("$1" "${2:?validation option needs a value}"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done
if ((${#VALIDATION_ARGS[@]})) && [[ "$COMMAND" != validate ]]; then
  echo "validation options require ./dev validate" >&2; exit 2
fi
if [[ "$STOP_VM" == true && "$COMMAND" != stop ]]; then
  echo "--vm requires ./dev stop" >&2; exit 2
fi
if [[ "$ASSUME_YES" == true && "$COMMAND" != reset ]]; then
  echo "--yes requires ./dev reset" >&2; exit 2
fi
if [[ "$GC_DELETE" == true && "$COMMAND" != gc ]]; then
  echo "--delete requires ./dev gc" >&2; exit 2
fi
if [[ "$PROFILE" != full && "$PROFILE" != offline ]]; then
  echo "profile must be full or offline" >&2
  exit 2
fi

pin() {
  awk -F= -v key="$1" '$1 == key {print $2; exit}' "$VERSIONS_FILE"
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo "missing sha256sum or shasum; cannot verify managed tool downloads" >&2
    return 2
  fi
}

download() {
  local url=$1 destination=$2 partial="${2}.part"
  mkdir -p "$(dirname "$destination")"
  echo "download: $url"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --show-error --progress-bar "$url" --output "$partial"
  elif command -v wget >/dev/null 2>&1; then
    wget --progress=bar:force:noscroll --output-document="$partial" "$url"
  else
    echo "missing curl or wget; one is required for the initial managed bootstrap" >&2
    return 2
  fi
  mv "$partial" "$destination"
}

# Checkout-local mise state. .mise.toml is trusted by path (it pins the Temporal CLI by URL and
# hash, which mise only reads from a trusted file) without writing any global trust record.
MISE_BIN="$ROOT_DIR/.harness/bin/mise"
export MISE_BIN
export MISE_DATA_DIR="$ROOT_DIR/.harness/mise"
export MISE_CACHE_DIR="$ROOT_DIR/.harness/mise-cache"
export MISE_STATE_DIR="$ROOT_DIR/.harness/mise-state"
export MISE_IGNORED_CONFIG_PATHS="${HOME}/.tool-versions:${HOME}/.config/mise/config.toml:${HOME}/.config/mise/conf.d"
export MISE_TRUSTED_CONFIG_PATHS="$ROOT_DIR/.mise.toml"
export PATH="$ROOT_DIR/.harness/bin:$PATH"

bootstrap_mise() {
  local version system machine artifact checksum url actual
  version="$(pin MISE_VERSION)"
  system="$(uname -s)"
  machine="$(uname -m)"
  case "$system/$machine" in
    Darwin/arm64|Darwin/aarch64)
      artifact="mise-v${version}-macos-arm64"
      checksum="$(pin MISE_MACOS_ARM64_SHA256)"
      ;;
    Linux/x86_64|Linux/amd64)
      artifact="mise-v${version}-linux-x64"
      checksum="$(pin MISE_LINUX_X64_SHA256)"
      ;;
    *)
      echo "unsupported host $system/$machine; supported: macOS Apple Silicon, Linux x86-64" >&2
      return 2
      ;;
  esac
  if [[ ! -x "$MISE_BIN" ]] || [[ "$(sha256_file "$MISE_BIN")" != "$checksum" ]]; then
    url="https://github.com/jdx/mise/releases/download/v${version}/${artifact}"
    download "$url" "$MISE_BIN"
    actual="$(sha256_file "$MISE_BIN")"
    if [[ "$actual" != "$checksum" ]]; then
      rm -f "$MISE_BIN"
      echo "mise checksum mismatch: expected $checksum, got $actual" >&2
      return 2
    fi
    chmod 0755 "$MISE_BIN"
  fi
}

case "$COMMAND" in
  start|check|test|smoke|doctor|reset|gc) bootstrap_mise ;;
  stop) if [[ "$STOP_VM" == true ]]; then bootstrap_mise; fi ;;
  status) if [[ "$PROFILE" == offline ]]; then bootstrap_mise; fi ;;
esac

dev_setup() {
  "$MISE_BIN" exec -- python scripts/dev_setup.py "$@"
}

setup() {
  dev_setup --profile "$PROFILE" "$@"
}

run_just() {
  "$MISE_BIN" exec -- just "$@"
}

load_env() {
  [[ -f "$ENV_FILE" ]] || { echo "no local environment; run ./dev first" >&2; return 2; }
  set -a
  # Generated by dev_setup.py with shell-quoted values and mode 0600.
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

compose() {
  load_env
  docker compose -f docker-compose.yml -f docker-compose.dev.yml \
    --project-name "$COMPOSE_PROJECT_NAME" --env-file "$ENV_FILE" "$@"
}

python_managed() {
  "$MISE_BIN" exec -- uv run --locked python "$@"
}

# The test suite must exercise durable replay: a missing Temporal CLI fails instead of skipping.
run_tests() {
  HARNESS_MODEL_MODE=stub HARNESS_TEST_REQUIRE_TEMPORAL=1 run_just test
}

offline() {
  setup
  export HARNESS_MODEL_MODE=stub
  run_just check
  run_tests
  echo "offline profile: passed (stub models, zero credentials)"
  echo "  just check: ruff over src, tests and scripts; compileall; agent spec validation"
  echo "  just test: deterministic suite incl. Temporal dev-server replay; network-marked tests excluded"
  echo "real Temporal service, API, web, persistence, and sandbox readiness: not_checked"
}

verify_sandbox() {
  load_env
  python_managed scripts/dev_sandbox_check.py \
    --runtime "$HARNESS_SANDBOX_RUNTIME" \
    --network "$HARNESS_BUILD_EGRESS_NETWORK" \
    --proxy "$HARNESS_BUILD_EGRESS_PROXY" \
    --builder "$HARNESS_BUILDX_BUILDER" \
    --compose-project "$COMPOSE_PROJECT_NAME"
}

smoke_stack() {
  load_env
  python_managed scripts/dev_setup_smoke.py \
    --api-url "http://127.0.0.1:${HARNESS_API_PORT}" \
    --web-url "http://127.0.0.1:${HARNESS_WEB_PORT}" \
    --temporal-address "127.0.0.1:${HARNESS_TEMPORAL_PORT}" \
    --minio-url "http://127.0.0.1:${HARNESS_MINIO_PORT}/minio/health/ready"
}

save_logs() {
  mkdir -p .harness/logs
  local log_file
  log_file="$(mktemp .harness/logs/compose-XXXXXXXX)"
  if [[ -n "$SERVICE" ]]; then
    compose logs --no-color --timestamps --tail=100 "$SERVICE" 2>&1 | tee "$log_file"
  else
    compose logs --no-color --timestamps --tail=100 2>&1 | tee "$log_file"
  fi
  echo "saved logs: $log_file"
}

start_full() {
  setup
  # Recreate so an edited allowlist is active before any build reaches the boundary.
  compose up -d --force-recreate egress-proxy
  verify_sandbox
  compose up --build -d
  smoke_stack
  save_logs
  echo "profile: full (stub inference; zero credentials and zero paid requests)"
  echo "sandbox: runsc probe and allowlisted build boundary passed"
  echo "temporal: deterministic API submission reached a terminal persisted result"
  echo "web: http://127.0.0.1:${HARNESS_WEB_PORT}"
  echo "api: http://127.0.0.1:${HARNESS_API_PORT}/docs"
  echo "temporal: http://127.0.0.1:${HARNESS_TEMPORAL_UI_PORT}"
  echo "artifacts: http://127.0.0.1:${HARNESS_MINIO_CONSOLE_PORT}"
  echo "traces: http://127.0.0.1:${HARNESS_JAEGER_PORT}"
  echo "logs: ./dev logs"
  echo "stop: ./dev stop (preserves VM, configuration, and data)"
}

case "$COMMAND" in
  start)
    if [[ "$PROFILE" == offline ]]; then offline; else start_full; fi
    ;;
  check)
    run_just check
    ;;
  test)
    run_tests
    ;;
  status)
    if [[ "$PROFILE" == offline ]]; then
      setup --check-only
      echo "offline profile: available (services are not running)"
    else
      compose ps
    fi
    ;;
  reload)
    compose restart api worker
    smoke_stack
    echo "reloaded API and worker; persisted data was preserved"
    ;;
  reload-ui)
    compose restart api web
    load_env
    python_managed scripts/ui_deployment_smoke.py --wait-ready \
      --api-url "http://127.0.0.1:${HARNESS_API_PORT}" \
      --web-url "http://127.0.0.1:${HARNESS_WEB_PORT}"
    echo "reloaded API and UI; GET-only deployment checks passed"
    ;;
  logs)
    save_logs
    ;;
  smoke)
    if [[ "$PROFILE" == offline ]]; then
      offline
    else
      setup --check-only
      verify_sandbox
      smoke_stack
    fi
    ;;
  doctor)
    setup --check-only
    if [[ "$PROFILE" == full ]]; then verify_sandbox; fi
    ;;
  validate)
    if [[ "$PROFILE" == offline ]]; then
      python_managed scripts/service_validation.py --offline \
        ${VALIDATION_ARGS[@]+"${VALIDATION_ARGS[@]}"}
    else
      load_env
      python_managed scripts/service_validation.py --managed-worker \
        --api-url "http://127.0.0.1:${HARNESS_API_PORT}" \
        --web-url "http://127.0.0.1:${HARNESS_WEB_PORT}" \
        ${VALIDATION_ARGS[@]+"${VALIDATION_ARGS[@]}"}
    fi
    ;;
  stop)
    if [[ -f "$ENV_FILE" ]]; then
      compose down
      echo "stopped $COMPOSE_PROJECT_NAME; configuration, volumes, and findings were preserved"
    else
      echo "no local environment; no stack to stop"
    fi
    if [[ "$STOP_VM" == true ]]; then dev_setup stop-vm; fi
    ;;
  reset)
    if [[ "$ASSUME_YES" == true ]]; then dev_setup reset --yes; else dev_setup reset; fi
    ;;
  gc)
    if [[ "$GC_DELETE" == true ]]; then dev_setup gc --delete; else dev_setup gc; fi
    ;;
esac
