            "type": "integer",
            "title": "Schema Version",
            "default": 1
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "population": {
            "type": "string",
            "title": "Population"
          },
          "total_runs": {
            "type": "integer",
            "title": "Total Runs"
          },
          "status_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Status Counts"
          },
          "verdict_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Verdict Counts"
          },
          "tokens": {
            "$ref": "#/components/schemas/Distribution"
          },
          "input_tokens": {
            "$ref": "#/components/schemas/Distribution"
          },
          "output_tokens": {
            "$ref": "#/components/schemas/Distribution"
          },
          "cost_usd": {
            "$ref": "#/components/schemas/Distribution"
          },
          "wall_time_s": {
            "$ref": "#/components/schemas/Distribution"
          },
          "agent_time_s": {
            "$ref": "#/components/schemas/Distribution"
          },
          "trends": {
            "items": {
              "$ref": "#/components/schemas/TrendPoint"
            },
            "type": "array",
            "title": "Trends"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/StageMetric"
            },
            "type": "array",
            "title": "Stages"
          },
          "definitions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Definitions"
          }
        },
        "type": "object",
        "required": [
          "as_of",
          "population",
          "total_runs",
          "status_counts",
          "verdict_counts",
          "tokens",
          "input_tokens",
          "output_tokens",
          "cost_usd",
          "wall_time_s",
          "agent_time_s",
          "trends",
          "stages",
          "definitions"
        ],
        "title": "MetricsResponse"
      },
      "ReviewRequest": {
        "properties": {
          "reviewer": {
            "type": "string",
            "title": "Reviewer",
            "default": ""
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "override_label": {
