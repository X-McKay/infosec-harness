  "components": {
    "schemas": {
      "FindingInput": {
        "properties": {
          "external_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Id",
            "description": "ID in the originating system"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "repo_url": {
            "type": "string",
            "title": "Repo Url",
            "description": "Git URL or a local path visible to the worker"
          },
          "revision": {
            "type": "string",
            "title": "Revision",
            "description": "Commit SHA, tag, or branch",
            "default": "HEAD"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line"
          },
          "end_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Line"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "cwe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwe",
            "description": "e.g. CWE-89"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "unknown"
          },
          "source_tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Tool"
          },
          "source_kind": {
            "$ref": "#/components/schemas/FindingSourceKind",
            "default": "generic_json"
          },
          "ado_work_item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ado Work Item Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "repo_url"
        ],
        "title": "FindingInput",
        "description": "The published generic JSON schema an external process submits (D1).\n\nOnly ``repo_url`` and ``title`` are required; anything missing is extracted from\n``description`` by the intake agent or the finding is parked as ``needs_info``."
      },
      "FindingSourceKind": {
        "type": "string",
        "enum": [
          "generic_json",
          "ado",
          "free_text"
        ],
        "title": "FindingSourceKind"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReviewRequest": {
        "properties": {
          "reviewer": {
            "type": "string",
            "title": "Reviewer",
            "default": ""
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "override_label": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerdictLabel"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ReviewRequest"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "info",
          "unknown"
        ],
        "title": "Severity"
      },
      "SubmitADORequest": {
        "properties": {
          "work_item_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Work Item Ids"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "work_item_ids"
        ],
        "title": "SubmitADORequest"
      },
      "SubmitRequest": {
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingInput"
            },
            "type": "array",
            "title": "Findings"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "default": ""
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "findings"
        ],
        "title": "SubmitRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerdictLabel": {
        "type": "string",
        "enum": [
          "potentially_exploitable",
          "likely_not_exploitable",
          "inconclusive"
        ],
        "title": "VerdictLabel"
      }
    }
  }
}