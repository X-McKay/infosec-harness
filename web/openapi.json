  "components": {
    "schemas": {
      "Bin": {
        "properties": {
          "lower": {
            "type": "number",
            "title": "Lower"
          },
          "upper": {
            "type": "number",
            "title": "Upper"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "lower",
          "upper",
          "count"
        ],
        "title": "Bin"
      },
      "Distribution": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "population": {
            "type": "integer",
            "title": "Population"
          },
          "coverage": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage"
          },
          "mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean"
          },
          "p50": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P50"
          },
          "p95": {
