            },
            "type": "array",
            "title": "Bins"
          }
        },
        "type": "object",
        "required": [
          "count",
          "population",
          "coverage"
        ],
        "title": "Distribution"
      },
      "FindingInput": {
        "properties": {
          "external_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Id",
            "description": "ID in the originating system"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "repo_url": {
            "type": "string",
            "title": "Repo Url",
            "description": "Git URL or a local path visible to the worker"
          },
          "revision": {
            "type": "string",
            "title": "Revision",
            "description": "Commit SHA, tag, or branch",
            "default": "HEAD"
          },
          "source_mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceMode"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explicit source identity mode; omitted for backwards-compatible inference"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line"
          },
          "end_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Line"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "cwe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cwe",
            "description": "e.g. CWE-89"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "unknown"
          },
          "source_tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Tool"
          },
          "source_kind": {
            "$ref": "#/components/schemas/FindingSourceKind",
            "default": "generic_json"
          },
          "ado_work_item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ado Work Item Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "repo_url"
        ],
        "title": "FindingInput",
        "description": "The published generic JSON schema an external process submits (D1).\n\nOnly ``repo_url`` and ``title`` are required; anything missing is extracted from\n``description`` by the intake agent or the finding is parked as ``needs_info``."
      },
      "FindingSourceKind": {
        "type": "string",
        "enum": [
          "generic_json",
          "ado",
          "free_text"
        ],
        "title": "FindingSourceKind"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricsResponse": {
        "properties": {
